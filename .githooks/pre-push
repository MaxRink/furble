#!/bin/sh
# Run the pre-review gates on every pushed commit (plan 314 PR 14).
#
# Enable once per clone:  git config core.hooksPath .githooks
# Skip for one push:      git push --no-verify
#
# git passes one "<local ref> <local sha> <remote ref> <remote sha>" line per
# pushed ref. A deletion has an all-zero local sha and nothing to review. Each
# pushed sha is checked out in a temporary detached worktree, so every gate
# sees that commit rather than the current branch or uncommitted files.
set -eu
cd "$(git rev-parse --show-toplevel)"
# Git exports GIT_DIR and friends to hooks. Clear them so the gate's scanner
# tests, which build scratch repositories, cannot write into this one.
unset $(git rev-parse --local-env-vars)
scratch=$(mktemp -d)
cleanup() {
  git worktree remove --force "$scratch/tree" >/dev/null 2>&1 || true
  rm -r "$scratch"
}
trap cleanup EXIT
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;;
  esac
  echo "pre-push: reviewing $local_ref ($local_sha) against origin/master"
  git worktree add --quiet --detach "$scratch/tree" "$local_sha"
  (cd "$scratch/tree" && python3 tools/pre_review.py --base origin/master --head "$local_sha") || status=1
  git worktree remove --force "$scratch/tree"
done
if [ "$status" -ne 0 ]; then
  echo "pre-push: pre-review failed; fix it or push with --no-verify" >&2
fi
exit "$status"
