  "indirect": [
    {
      "caller": "^(esp_event_loop_run|handler_execute)$",
      "targets": [
        "Furble::MQTT::eventHandler\\(void\\*, esp_event_base_t, int32_t, void\\*\\)$"
      ],
      "tasks": [
        "mqtt_client"
      ],
      "why": "esp-mqtt runs its own event loop on the client task and registers only MQTT::eventHandler on it (src/FurbleMQTT.cpp esp_mqtt_client_register_event)"
    },
    {
      "caller": "^lv_event_send$",
      "targets": [
        "\\(lv_event_t\\*\\)$"
      ],
      "why": "lv_event.c calls each registered event_cb"
    },
    {
      "caller": "^lv_obj_event_base$",
      "targets": [
        "^lv_\\w+_event$"
      ],
      "why": "lv_obj_event.c calls the widget class event_cb; LVGL is C, so its class callbacks match by their lv_<class>_event name"
    },
    {
      "caller": "^lv_timer_handler(_resume)?$",
      "targets": [
        "\\(lv_timer_t\\*\\)$"
      ],
      "why": "lv_timer.c calls each timer_cb"
    },
    {
      "caller": "^draw_buf_flush$",
      "targets": [
        "\\(lv_display_t\\*, const lv_area_t\\*, uint8_t\\*\\)$"
      ],
      "why": "lv_refr.c calls the display flush_cb"
    },
    {
      "caller": "^lv_indev_read$",
      "targets": [
        "\\(lv_indev_t\\*, lv_indev_data_t\\*\\)$"
      ],
      "why": "lv_indev.c calls the indev read_cb"
    },
    {
      "caller": "^(esp_event_loop_run|handler_execute)$",
      "targets": [
        "\\(void\\*, esp_event_base_t, int32_t, void\\*\\)$"
      ],
      "why": "esp_event.c handler_execute calls each registered esp_event_handler_t; it is inlined into esp_event_loop_run on some builds and a separate function on others. esp-mqtt dispatches its events through it on the client task"
    }
  ],
  "boot_only": [
    "^void m5::M5Unified::begin\\(config_t\\)$",
    "^esp_err_t nvs::Storage::init\\(uint32_t, uint32_t\\)$"
  ],
  "boot_only_comment": "Functions that run once on main before any task exists, so other tasks never reach them. M5.begin() runs only in the Platform constructor, which Platform::init() runs at src/main.cpp before the first xTaskCreate; a later Platform::getInstance() returns the built object. nvs::Storage::init runs only for a partition that is not yet initialized; Settings::init() initializes NVS in app_main before any task starts, so a later Preferences::begin() returns from nvs_flash_init_partition early."
}
