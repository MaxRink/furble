---
# Static-analysis policy for the production and simulator sources.
#
# The checks below are the high-signal set that has been triaged against the
# current tree. Noisy families are deliberately off, each with a reason:
#
# - signed bitwise operations, enum size, and static initialization on an
#   exception-free embedded target are noise here;
# - LVGL and ESP-IDF C typedefs are linkage-compatible handles, not anonymous
#   structs we can rename;
# - public APIs intentionally take values or const references, and ordered
#   containers are used for deterministic host output;
# - every scanf caller checks its return value, and the remaining atoi sites
#   are converted where they are not already bounded;
# - the preferences shim uses a leading underscore in its include guard;
# - ESP-IDF config structs (wifi_config_t, rmt_tx_channel_config_t) are
#   zero-initialized by their documented contract, and several of their C
#   enums have no zero enumerator.
#
# cppcoreguidelines-owning-memory flags C++ new and delete whose pointer is not
# a std::unique_ptr or gsl::owner. Its legacy-resource lists are emptied: FILE
# handles and the C allocators are tracked by the path-sensitive
# clang-analyzer-unix.Stream and unix.Malloc checks instead, which need no
# annotations on C APIs. The memory families are errors so a direct
# clang-tidy run fails the same way the gate does.
#
# `tools/check_static_analysis.py` runs this config on changed files in CI.
Checks: >
  bugprone-*,
  clang-analyzer-*,
  cppcoreguidelines-owning-memory,
  cert-*,
  performance-*,
  portability-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-reserved-identifier,
  -bugprone-branch-clone,
  -bugprone-macro-parentheses,
  -bugprone-signed-bitwise,
  -bugprone-invalid-enum-default-initialization,
  -bugprone-throwing-static-initialization,
  -bugprone-switch-missing-default-case,
  -bugprone-nondeterministic-pointer-iteration-order,
  -bugprone-random-generator-seed,
  -bugprone-unchecked-string-to-number-conversion,
  -cert-err33-c,
  -cert-err34-c,
  -cert-err58-cpp,
  -cert-dcl21-cpp,
  -cert-dcl37-c,
  -cert-dcl50-cpp,
  -cert-dcl51-cpp,
  -clang-diagnostic-missing-field-initializers,
  -clang-diagnostic-non-c-typedef-for-linkage,
  -clang-analyzer-optin.performance.Padding,
  -performance-enum-size,
  -performance-inefficient-vector-operation,
  -performance-no-automatic-move,
  -performance-no-int-to-ptr,
  -performance-unnecessary-copy-initialization,
  -performance-unnecessary-value-param,
  -portability-avoid-pragma-once
HeaderFilterRegex: '(src|lib/furble|include|sim)/'
FormatStyle: file
WarningsAsErrors: 'cppcoreguidelines-owning-memory,bugprone-unchecked-optional-access,bugprone-use-after-move,bugprone-dangling-handle,clang-analyzer-cplusplus.NewDelete*,clang-analyzer-cplusplus.InnerPointer,clang-analyzer-unix.Malloc*,clang-analyzer-unix.Stream'
CheckOptions:
  cppcoreguidelines-owning-memory.LegacyResourceProducers: ''
  cppcoreguidelines-owning-memory.LegacyResourceConsumers: ''
...
