{
  "name": "furble",
  "version": "$VERSION",
  "new_install_prompt_erase": true,
  "new_install_improv_wait_time": 0,
  "builds": [
    {
      "chipFamily": "$CHIP_FAMILY",
      "parts": [
        { "path": "$ASSET_BASE_URL/furble-bootloader-$PLATFORM-$VERSION.bin", "offset": $BOOTLOADER_OFFSET },
        { "path": "$ASSET_BASE_URL/furble-partitions-$PLATFORM-$VERSION.bin", "offset": $PARTITION_TABLE_OFFSET },
        { "path": "$ASSET_BASE_URL/furble-ota_data_initial-$PLATFORM-$VERSION.bin", "offset": $OTA_DATA_OFFSET },
        { "path": "$ASSET_BASE_URL/furble-$PLATFORM-$VERSION.bin", "offset": $APP_OFFSET }
      ]
    }
  ]
}
